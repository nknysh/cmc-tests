{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "@playwright/test"],
    "paths": {
      "@src/*": ["./src/*"],
      "@tests/*": ["./tests/*"],
      "@agents/*": ["./.agents/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", ".agents/**/*.ts", ".agents/**/*.mts", "playwright.config.ts"]
}
