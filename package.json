{
  "name": "cmc-tests",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:api": "rm -rf allure-results/api && ALLURE_SUITE=api playwright test --project=api",
    "test:contract": "rm -rf allure-results/contract && ALLURE_SUITE=contract SKIP_BTC_PRICE_HEAL=1 playwright test --project=contract",
    "test:btc-price": "rm -rf allure-results/btc-price && ALLURE_SUITE=btc-price playwright test --project=btc-price",
    "test:e2e": "rm -rf allure-results/navigation && ALLURE_SUITE=navigation playwright test --project=e2e",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "allure:generate": "allure generate allure-results/${ALLURE_SUITE:-adhoc}",
    "allure:api": "ALLURE_SUITE=api npm run allure:generate",
    "allure:contract": "ALLURE_SUITE=contract npm run allure:generate",
    "allure:btc-price": "ALLURE_SUITE=btc-price npm run allure:generate",
    "allure:navigation": "ALLURE_SUITE=navigation npm run allure:generate",
    "allure:gate": "allure quality-gate allure-results/${ALLURE_SUITE:-adhoc}",
    "allure:open": "allure open allure-report/${ALLURE_SUITE:-adhoc}",
    "test:allure": "npm run test:btc-price; npm run allure:btc-price; npm run test:contract; npm run allure:contract; npm run test:api; npm run allure:api; npm run test:e2e; npm run allure:navigation",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "viewer": "tsx src/web/testCaseViewer/server.ts",
    "code-review": "node .agents/code-review-hook/PreCommitCodeReviewHook.mts",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.5",
    "allure": "^3.18.0",
    "allure-js-commons": "^3.12.2",
    "allure-playwright": "^3.12.2",
    "eslint": "^10.11.0",
    "eslint-plugin-playwright": "^2.12.0",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "typescript7": "npm:typescript@^7.0.2",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.282",
    "dotenv": "^17.4.2",
    "node-llama-cpp": "^3.21.1"
  },
  "allowScripts": {
    "node-llama-cpp@3.21.1": true
  }
}
